{{- $pages := where .Site.RegularPages "Type" "in" .Site.MainSections -}}
{{- $dateFormat := "2006-01-02T15:04:05-07:00" -}}
{{- with .Site.Config.Services.RSS.Limit -}}
  {{- if ge . 1 -}}
    {{- $pages = $pages | first . -}}
  {{- end -}}
{{- end -}}
{{ print "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:webfeeds="http://webfeeds.org/rss/1.0">

{{- with .Site.Params.author.name }}
<author>
  <name>{{ . }}</name>
  <uri>{{ $.Site.BaseURL }}</uri>
</author>
{{ end -}}

<generator uri="https://gohugo.io">Hugo {{ .Site.Hugo.Version }}</generator>
<id>{{ .Permalink }}</id>

{{- with .OutputFormats.Get "atom" }}
{{ printf `<link rel="self" type="%s" href="%s" hreflang="%s"/>` .MediaType.Type .Permalink $.Site.Language.Locale | safeHTML }}
{{- end }}
{{- range .AlternativeOutputFormats }}
{{ printf `<link rel="alternate" type="%s" href="%s" hreflang="%s"/>` .MediaType.Type .Permalink $.Site.Language.Locale | safeHTML }}
{{- end }}

{{- with .Site.Params.logo }}
<logo>{{ . | absURL }}</logo>
{{- end }}

{{- with .Site.Params.Description }}
<subtitle>{{ . }}</subtitle>
{{- end }}
<title>{{ .Site.Title }}</title>
<updated>{{ now.Format $dateFormat | safeHTML }}</updated>

{{- range $pages }}
<entry>
  {{- with .Params.Author  | default $.Site.Params.author.name }}
  <author>
    <name>{{ . }}</name>
  </author>
  {{- end }}
  <id>{{ .Permalink }}</id>
  <link rel="alternate" href="{{ .Permalink }}"/>
  <title>{{ .Title }}</title>
  <published>{{ .Date.Format $dateFormat | safeHTML }}</published>
  <updated>{{ .Lastmod.Format $dateFormat | safeHTML }}</updated>
  {{- with .Summary }}
  <summary type="html">{{ . | transform.XMLEscape | safeHTML }}</summary>
  {{- end }}
  <content type="html" xml:base="{{ .Site.BaseURL }}" xml:lang="en">
    {{ .Content | transform.XMLEscape | safeHTML }}
  </content>
</entry>
{{- end }}
</feed>
